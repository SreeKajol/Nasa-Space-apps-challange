# Base URL of the pipeline's static files (index.json, region/, grid/, hotspots/).
# Absolute (https://…) or relative to the app root (./demo-data).
# When set, the app uses the StaticJsonAdapter by default and hides the "Demo data" badge.
# Leave unset to run on the built-in synthetic demo data.
VITE_DATA_BASE_URL=

# NASA FIRMS MAP_KEY for `make fetch` / `make real` (Python only: never bundled into the app).
# Free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/  ·  copy this file to .env and fill it in.
FIRMS_MAP_KEY=
