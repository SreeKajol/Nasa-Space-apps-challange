{
  "name": "firerings",
  "version": "1.0.0",
  "description": "FireRings — আগুন পঞ্জিকা — Almanaque del Fuego. 25 years of Earth's fire memory, unbroken.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "format": "node node_modules/prettier/bin/prettier.cjs --write .",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "demo-data": "node scripts/generate-demo-data.ts",
    "ml": "node scripts/ml.mjs",
    "ml:copy": "node scripts/copy-ml.mjs",
    "ml:demo-inputs": "node scripts/generate-demo-data.ts data-products/demo && node scripts/export-ml-demo-inputs.ts data-products/demo",
    "fetch": "node scripts/real.mjs fetch",
    "real": "node scripts/real.mjs real",
    "snapshot": "node scripts/snapshot.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
