    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tanstack/react-query": "^5.106.0",
    "clsx": "^2.1.1",
    "d3-array": "^3.2.5",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.575.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.3.4"
